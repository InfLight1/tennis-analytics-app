{
  "expo": {
    "name": "Advantage AI",
    "slug": "advantage-ai",
    "scheme": "advantageai",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1410",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.advantageai.tennis",
      "infoPlist": {
        "NSCameraUsageDescription": "Advantage AI films your match with the camera.",
        "NSMicrophoneUsageDescription": "Advantage AI records the sound of the match with the video.",
        "NSPhotoLibraryUsageDescription": "Pick a match video to send for a report.",
        "NSPhotoLibraryAddUsageDescription": "Save your match video to Photos if you want to keep it.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0A1410"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-sharing",
      "expo-notifications",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c88f4eaf-74d8-4d2b-9b77-bc4c7aa0ad02"
      }
    },
    "owner": "infinite_lightning",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c88f4eaf-74d8-4d2b-9b77-bc4c7aa0ad02",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
